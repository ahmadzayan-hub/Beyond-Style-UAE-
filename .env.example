# BSOS configuration. Copy to .env — never commit .env.

# Data root (defaults to the repository root).
#BSOS_ROOT=.

# --- LLM / vision abstraction (attribute extraction, bilingual copy) -------
# Without this key, attribute extraction is unavailable (tests use a fake).
ANTHROPIC_API_KEY=
BSOS_LLM_MODEL=claude-sonnet-5

# --- Image generation: Google Nano Banana family ---------------------------
# Without this key, BSOS uses a LOCAL DEV placeholder renderer that draws the
# prompt text on a card. It is not a product visual; get a key before real
# concept work. The live model list is checked at startup and BSOS refuses to
# start if a configured id has vanished.
GOOGLE_API_KEY=
BSOS_IMAGEGEN_MODELS=gemini-3-pro-image,gemini-3.1-flash-image,gemini-3.1-flash-lite-image

# --- Meta Graph API (Business Discovery, own media) -------------------------
# Facebook Login path only. See SETUP.md for app creation and token steps.
META_ACCESS_TOKEN=
META_IG_USER_ID=
